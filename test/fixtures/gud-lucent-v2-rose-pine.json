{
  "$schema": "https://opencode.ai/theme.json",
  "base": {
    "categorical": ["cyan","pink","green","red","blue"],
    "text": {
      "base": "$hue.neutral.200",
      "muted": "$hue.neutral.400",
      "action": {
        "primary": {
          "base": "$text.base",
          "$disabled": "$text.muted",
          "$focused": "#000000",
          "$selected": "$hue.interactive.200"
        },
        "secondary": { "base": "$text.muted", "$hovered": "$text.base" },
        "destructive": { "base": "#000000", "$disabled": "$text.muted" }
      },
      "formfield": {
        "base": "$text.base",
        "$hovered": "$hue.interactive.200",
        "$focused": "$hue.interactive.200",
        "$pressed": "$hue.interactive.200",
        "$disabled": "$text.muted",
        "$selected": "$hue.interactive.200"
      },
      "feedback": {
        "error": { "base": "$hue.red.200" },
        "warning": { "base": "$hue.orange.200" },
        "success": { "base": "$hue.green.200" },
        "info": { "base": "$hue.blue.200" }
      }
    },
    "background": {
      "base": "transparent",
      "raised": { "base": "transparent", "high": "transparent", "max": "transparent" },
      "action": {
        "primary": {
          "base": "transparent",
          "$hovered": "$background.raised.base",
          "$focused": "$hue.interactive.200",
          "$selected": "transparent"
        },
        "secondary": { "base": "transparent" },
        "destructive": { "base": "$hue.red.200" }
      },
      "formfield": { "base": "$background.base" },
      "feedback": {
        "error": { "base": "$background.base" },
        "warning": { "base": "$background.base" },
        "success": { "base": "$background.base" },
        "info": { "base": "$background.base" }
      }
    },
    "border": { "base": "$hue.neutral.600" },
    "scrollbar": { "base": "$hue.purple.200" },
    "diff": {
      "text": {
        "added": "$hue.green.200",
        "removed": "$hue.red.200",
        "context": "$hue.neutral.200",
        "hunkHeader": "$hue.neutral.400"
      },
      "background": {
        "added": "#1c2231",
        "removed": "#43293a",
        "context": "$hue.neutral.700"
      },
      "highlight": { "added": "$hue.green.200", "removed": "$hue.red.200" },
      "lineNumber": {
        "text": "$hue.neutral.400",
        "background": {
          "added": "#1c2231",
          "removed": "#43293a"
        }
      }
    },
    "syntax": {
      "comment": "$hue.neutral.400",
      "keyword": "$hue.purple.200",
      "function": "$hue.green.200",
      "variable": "$hue.neutral.200",
      "string": "$hue.yellow.200",
      "number": "$hue.blue.200",
      "type": "$hue.cyan.200",
      "operator": "$hue.purple.200",
      "punctuation": "$hue.neutral.200"
    },
    "markdown": {
      "text": "$hue.neutral.200",
      "heading": "$hue.purple.200",
      "link": "$hue.cyan.200",
      "linkText": "$hue.pink.200",
      "code": "$hue.green.200",
      "blockQuote": "$hue.neutral.400",
      "emphasis": "$hue.yellow.200",
      "strong": "$hue.orange.200",
      "horizontalRule": "$hue.neutral.400",
      "listItem": "$hue.cyan.200",
      "listEnumeration": "$hue.blue.200",
      "image": "$hue.pink.200",
      "imageText": "$hue.yellow.200",
      "codeBlock": "$hue.green.200"
    },
    "@dialog": {
      "background": {
        "base": "$background.raised.base",
        "action": { "primary": { "$hovered": "$background.raised.high" } }
      }
    }
  },
  "dark": {
    "hue": {
      "gray": {
        "100": "#ffffff",
        "200": "#e0def4",
        "300": "#a5a2bc",
        "400": "#6e6a86",
        "500": "#48455f",
        "600": "#26233a",
        "700": "#1f1d2e",
        "800": "#191724",
        "900": "#13111a"
      },
      "red": {
        "100": "#fc8eaa",
        "200": "#eb6f92",
        "300": "#cd5d7d",
        "400": "#af4b68",
        "500": "#923954",
        "600": "#772841",
        "700": "#5c182f",
        "800": "#42071d",
        "900": "#28010e"
      },
      "orange": {
        "100": "#fde7c9",
        "200": "#f6c177",
        "300": "#d4a460",
        "400": "#b2884b",
        "500": "#926c35",
        "600": "#735221",
        "700": "#55390b",
        "800": "#382301",
        "900": "#1b0f01"
      },
      "yellow": {
        "100": "#fedfde",
        "200": "#ebbcba",
        "300": "#caa09e",
        "400": "#aa8482",
        "500": "#8b6968",
        "600": "#6d504f",
        "700": "#503837",
        "800": "#352121",
        "900": "#1c0d0c"
      },
      "green": {
        "100": "#3b83a1",
        "200": "#31748f",
        "300": "#28657e",
        "400": "#1e566c",
        "500": "#15485c",
        "600": "#0c3b4c",
        "700": "#042d3c",
        "800": "#03202c",
        "900": "#01141d"
      },
      "cyan": {
        "100": "#b6eef8",
        "200": "#9ccfd8",
        "300": "#83b1b9",
        "400": "#6a949b",
        "500": "#53787e",
        "600": "#3c5d63",
        "700": "#274348",
        "800": "#132b2f",
        "900": "#021518"
      },
      "blue": {
        "100": "#dec4fd",
        "200": "#c4a7e7",
        "300": "#a88ec8",
        "400": "#8d76a9",
        "500": "#735e8c",
        "600": "#5a476f",
        "700": "#423254",
        "800": "#2b1e3a",
        "900": "#160b22"
      },
      "purple": {
        "100": "#fde7c9",
        "200": "#f6c177",
        "300": "#d4a460",
        "400": "#b2884b",
        "500": "#926c35",
        "600": "#735221",
        "700": "#55390b",
        "800": "#382301",
        "900": "#1b0f01"
      },
      "pink": {
        "100": "#fde7c9",
        "200": "#f6c177",
        "300": "#d4a460",
        "400": "#b2884b",
        "500": "#926c35",
        "600": "#735221",
        "700": "#55390b",
        "800": "#382301",
        "900": "#1b0f01"
      },
      "accent": "$hue.pink",
      "interactive": "$hue.purple",
      "neutral": "$hue.gray"
    }
  }
}
