{
  "name": "opencode-pillbox-statusline",
  "version": "0.0.0",
  "description": "Config-driven footer statusline for OpenCode V2: themed pills for project, Git, agent, context, cost, and provider quota",
  "type": "module",
  "license": "MIT",
  "author": "Dane Morgan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crag-h4k/opencode-pillbox-statusline.git"
  },
  "homepage": "https://github.com/crag-h4k/opencode-pillbox-statusline#readme",
  "bugs": {
    "url": "https://github.com/crag-h4k/opencode-pillbox-statusline/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode-v2",
    "statusline",
    "footer",
    "tui",
    "quota"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./tui": "./src/tui.tsx",
    "./rpc": "./src/rpc.ts"
  },
  "files": [
    "src/",
    "docs/",
    "schema.json",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --experimental-ffi --disable-warning=ExperimentalWarning --test \"test/*.test.mjs\"",
    "typecheck": "tsc --noEmit",
    "schema": "node scripts/schema.mjs"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.0.26",
    "@opentui/core": ">=0.5.17",
    "@opentui/solid": ">=0.5.17",
    "effect": ">=4.0.1 <5",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@opencode/plugin": "2.0.29",
    "@opencode/theme": "2.0.29",
    "@opentui/core": "0.6.5",
    "@opentui/solid": "0.6.5",
    "@types/node": "24.19.2",
    "effect": "4.0.1",
    "solid-js": "1.9.12",
    "typescript": "5.9.3"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=26.4.0",
      "onFail": "warn"
    }
  }
}
